{
  "info": {
    "name": "KingdomPay Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Request OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/auth/otp/request", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "otp", "request"] },
        "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{phone_number}}\"\n}" }
      }
    },
    {
      "name": "Auth - Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/auth/otp/verify", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "otp", "verify"] },
        "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{phone_number}}\",\n  \"otp_code\": \"000000\",\n  \"full_name\": \"{{full_name}}\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.tokens) {",
              "  pm.environment.set('access_token', json.tokens.access_token);",
              "  pm.environment.set('refresh_token', json.tokens.refresh_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Wallet - Balance",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/wallets/balance", "host": ["{{base_url}}"], "path": ["api", "v1", "wallets", "balance"] }
      }
    },
    {
      "name": "Community - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/communities", "host": ["{{base_url}}"], "path": ["api", "v1", "communities"] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"My Community\",\n  \"type\": \"CHURCH\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.community) { pm.environment.set('community_id', json.community.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Community - Invite",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/communities/{{community_id}}/invite", "host": ["{{base_url}}"], "path": ["api", "v1", "communities", "{{community_id}}", "invite"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.invite) { pm.environment.set('invite_token', json.invite.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Community - Join by Token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/communities/join", "host": ["{{base_url}}"], "path": ["api", "v1", "communities", "join"] },
        "body": { "mode": "raw", "raw": "{\n  \"token\": \"{{invite_token}}\"\n}" }
      }
    },
    {
      "name": "Campaign - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/campaigns", "host": ["{{base_url}}"], "path": ["api", "v1", "campaigns"] },
        "body": { "mode": "raw", "raw": "{\n  \"community_id\": {{community_id}},\n  \"title\": \"General Offering\",\n  \"type\": \"OFFERING\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.campaign) { pm.environment.set('campaign_id', json.campaign.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Campaign - Contribute",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Idempotency-Key", "value": "{{idem_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/campaigns/{{campaign_id}}/contribute", "host": ["{{base_url}}"], "path": ["api", "v1", "campaigns", "{{campaign_id}}", "contribute"] },
        "body": { "mode": "raw", "raw": "{\n  \"amount\": 100,\n  \"memo\": \"Blessings\"\n}" }
      }
    },
    {
      "name": "Reports - CSV",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": { "raw": "{{base_url}}/api/v1/communities/{{community_id}}/reports/transactions.csv", "host": ["{{base_url}}"], "path": ["api", "v1", "communities", "{{community_id}}", "reports", "transactions.csv"] }
      }
    }
  ]
}
